\@writefile{toc}{\contentsline {section}{\numberline {3}Q1: Unit-cell design at broadside}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Design strategy}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Optimum design and result}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Q1 design summary. \textbf  {Top-left:} active input impedance vs frequency at broadside; the resonance is centred near $f_c$ and Re$\{Z\}$ crosses $\SI {100}{\Omega }$ inside the band. \textbf  {Top-right:} active reflection coefficient with backing reflector (blue) vs free space (red); the reflector improves in-band match by more than $\SI {14}{dB}$. \textbf  {Bottom-left:} contour of worst-case in-band $|\Gamma |$ over $(h, l)$ at $Z_L = \SI {100}{\Omega }$; the $-\SI {10}{dB}$ contour bounds a sizeable design region. \textbf  {Bottom-right:} 1-D sweep of $Z_L$ at the optimum $(h,l)$, showing a clean minimum at $\SI {100}{\Omega }$.}}{4}{}\protected@file@percent }
\newlabel{fig:Q1}{{1}{4}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Q2: Maximum scan angle and grating-lobe analysis}{4}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Grating-lobe-free lattice}{4}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Grating-lobe diagram at the band edges and centre. The blue disk is the visible region; the grey circles are the higher-order Floquet circles centred at $(m_x\lambda /d_x, m_y\lambda /d_y)$. None of them touches the visible region for any frequency in the band, so no grating lobes appear at any scan angle.}}{5}{}\protected@file@percent }
\newlabel{fig:GL}{{2}{5}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Scan-induced impedance mismatch}{5}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces $|\Gamma _{\text  {act}}|$ vs scan angle in the E, H and D planes at $f = 27.5,\,29.25,\,\SI {31}{GHz}$. The dashed red lines mark the worst-case-across-band $\pm \theta _{0,\max }$ where the curve crosses the $\SI {-10}{dB}$ specification.}}{5}{}\protected@file@percent }
\newlabel{fig:Q2}{{3}{5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces H-plane $|\Gamma _{\text  {act}}|$ in the $(\theta _0, f)$ plane. White lines are the band edges. The red contour bounds the $\SI {-10}{dB}$ region. Outside this region the array is mismatched.}}{6}{}\protected@file@percent }
\newlabel{fig:Q2_2D}{{4}{6}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Q3: Number of elements for $\mathrm  {HPBW} = 2^\circ $}{6}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Closed-form estimate}{6}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Numerical verification}{6}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Q3 array sizing at $f_c = \SI {29.25}{GHz}$. \textbf  {Left:} broadside pattern for $N = 25\ldots  65$. \textbf  {Right:} HPBW vs $N$, simulation (blue) vs closed-form $0.886\lambda /(Nd)$ (red dashed). $N = 55$ achieves the $2^\circ $ specification at $f_c$.}}{7}{}\protected@file@percent }
\newlabel{fig:Q3}{{5}{7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Pattern of the chosen $55\times 55$ array across the band. The HPBW shrinks at higher frequency ($\SI {1.85}{deg}$ at \SI {31}{GHz}) and slightly exceeds the $2^\circ $ target at $f_{lo}$ ($\SI {2.09}{deg}$).}}{7}{}\protected@file@percent }
\newlabel{fig:Q3_band}{{6}{7}{}{}{}}
